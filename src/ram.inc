aiScriptBuf            = $0680 ; 3 ; (size 32) CPU fighter 0: the running action script, translated (AiStartAction); $069F is set to $FF
aiScriptBuf2           = $06A0 ; 3 ; (size 32) CPU fighter 1: same; $06BF is set to $FF
aiAction               = $06C0 ; 8 ; (size 2) action to start next frame (0 = keep running the buffer, $FF = none: choose a new one)
aiScriptPos            = $06C2 ; 15 ; (size 2) read position in aiScriptBuf
aiHoldTimer            = $06C4 ; 10 ; (size 2) frames left to keep the pad as it is (AI_STEP_HOLD)
aiPad                  = $06C6 ; 58 ; (size 2) pad bits the AI held last frame
aiPadKeep              = $06C8 ; 43 ; (size 2) pad bits kept held under the next script bytes
aiMode                 = $06CA ; 6 ; (size 2) 0 = init (AiInit), 1 = choose an action, 2 = run it
aiPadTimer             = $06CC ; 5 ; (size 2) frames left for AI_STEP_TIMED (then the pad is released)
aiSituation            = $06CE ; 3 ; (size 2) hash of the situation last seen while running: a change lets AiReact interrupt
aiStep                 = $06D2 ; 17 ; (size 2) AI_STEP_*: what AiStepScript does this frame
aiCond                 = $06D4 ; 7 ; (size 2) AIC_* condition waited for in AI_STEP_WAIT
aiTargetDx             = $06D6 ; 15 ; (size 2) target X - own X, big endian (hi, lo): bit 7 of the first byte = target is to the left
aiBallDx               = $06D8 ; 10 ; (size 2) ball (slot 6) X - own X (ObjDeltaX16), big endian (hi, lo); set by GetBallRange, read by the AI conditions
aiCondArg              = $06DA ; 32 ; (size 2) argument / counter of the current condition
aiTapCount             = $06DC ; 4 ; (size 2) AI_TAP_B presses done (while non-zero the executor runs every frame)
aiTarget               = $06DE ; 79 ; (size 2) slot the AI reacts to: AiInit sets it to the other fighter (X EOR 1); values 0/1 only
aiCondTimer            = $06E0 ; 7 ; (size 2) frames left before some conditions give up ($C0 on reset)
aiLastAction           = $06E2 ; 10 ; (size 2) last action started (read by the character decision routines)
aiInterrupted          = $06E4 ; 7 ; (size 2) set when AiDecide has interrupted the running action: no more interruptions until AiResetState
aiLocked               = $06E6 ; 9 ; (size 2) non-zero (AI_LOCK): the action may not be interrupted and AiResetState does nothing
aiRanges               = $06E8 ; 10 ; (size 8) 4 per fighter (AiInit): dat_DF1C - 1, then AiRangeTable; +0..+2 = fighterGap limits of range classes 1-3, the entry of the current class goes to $0C
aiNoInterrupt          = $06F0 ; 3 ; $FF before AiDecide in the run mode; AiResetState clears it, and only then the decided action replaces the running one
aiGapSeen              = $06F1 ; 2 ; (size 2) fighterGap when AiStepScript last ran
aiShotSeen             = $06F3 ; 4 ; AiNoticeShot rolled for the current ball shot
aiFlagF4               = $06F4 ; 2 ; (size 2) per fighter: only ever cleared (AiInit, AiResetState); no code reads it
aiCondCount            = $06F6 ; 3 ; (size 2) AICS_1 hold counter (AiCondHoldTimes)
aiShotRange            = $06F8 ; 6 ; range class of the target's flying shot (ATK_SHREDDER_WAVE / ATK_CASEY_RAIN), $FF = none
aiCondCount2           = $06FA ; 2 ; (size 2) AICS_8 counter
sndBaseLen             = $0700 ; 11 ; (size 6) base length (frames per length unit): SC_LEN / SC_LENGTH / SFX header
sndTimer               = $0706 ; 10 ; (size 6) frames left of the current note
sndChanId              = $070C ; 15 ; (size 6) sound id playing on the channel, 0 = idle (a new SFX takes a channel only with an id >= this one)
sndPtrLo               = $0712 ; 5 ; (size 6) stream position
sndPtrHi               = $0718 ; 5 ; (size 6) 
sndLoopLo              = $071E ; 3 ; (size 12) SC_LOOP start (first 6) and SC_LOOP2 start (last 6)
sndLoopHi              = $072A ; 3 ; (size 12) 
sndLoopCount           = $0736 ; 5 ; (size 12) SC_REPEAT counter for each loop level
sndReturnLo            = $0742 ; 2 ; (size 6) return address of SC_CALL
sndReturnHi            = $0748 ; 2 ; (size 6) 
sndVolume              = $074E ; 16 ; current volume (envelope step); UpdateChannel lowers it once per sndFadeSteps count
sndDutyFlags           = $0750 ; 5 ; SC_DUTY argument when its low nibble is not 0: bit 1 makes the volume register use its high nibble instead of sndDuty (WriteVolFlags)
sndDuty                = $0754 ; 7 ; duty bits (high nibble of the second SC_LEN byte)
sndVolumeBase          = $0756 ; 5 ; volume (low nibble of the second SC_LEN byte)
sndPeriodHiOut         = $0759 ; 4 ; last period high byte written ($F8 = write the next one)
sndNewId               = $075C ; 6 ; id SoundStart is starting
sndPeriodLoOut         = $075E ; 2 ; last period low byte written
sndChannel             = $0761 ; 9 ; channel X being updated
sndDetune              = $0763 ; 5 ; SC_DETUNE: bit 7 = up, bits 0-6 = period offset
fadeOutSteps           = $0766 ; 4 ; FadeOutMusic: steps left (UpdateFadeOut)
sndVibFlags            = $0768 ; 12 ; bit 7 = vibrato on (SC_VIBRATO sets it, a 0 argument clears it)
fadeOutVolume          = $076B ; 3 ; volume taken off every music channel
sndVolOffset           = $076D ; 5 ; SC_VOLUME
sndVolMin              = $076F ; 6 ; SC_FLAGS bits 7-6: lowest volume ChannelVolume allows (clamp branch never ran in the logs)
sndSweep               = $0772 ; 6 ; sweep register value ($7F = off)
sndEchoFlags           = $0774 ; 13 ; SC_FLAGS: bit 7 = echo on (EchoStore after each note), bit 5 = reset the echo buffer (EchoStore), bit 4 = note-length boundary mode (NoteLengthBoundary), bits 3-2 = non-zero: no volume decay before the release point, and at it the volume is set to this value (1-3) instead of fading (UpdateChannel), bits 0-1 = echo delay (EchoPeriodLoad)
sfxSkip                = $0777 ; 6 ; SoundStart: count of header entries to skip; per channel in the slide command: SC_SLIDE step byte (bit 7 = add, bits 0-6 = amount)
fadeOutSpeed           = $077A ; 2 ; frames per fade step
sndTemp2               = $077C ; 15 ; scratch: length multiplier, stream offset, SFX channel
sfxHeaderIdx           = $0781 ; 10 ; SoundStart: SfxChannels index of the channel being started
sndByte                = $0786 ; 18 ; scratch: SFX header channel bits, packed note byte (0 = read the stream)
sfxHeaderMask          = $078B ; 5 ; SoundStart: channel bits left to start
sndEchoIdx             = $078D ; 5 ; write index (0-3) of the channel's 4-entry echo ring in sndEchoLo/Hi (EchoStore)
sfxChannelMask         = $0790 ; 11 ; channels taken by SFX
sndFadeTimer           = $0792 ; 2 ; cleared by ResetEnvTimers and the channel init; never read
sndChanBit             = $0795 ; 10 ; ChannelBit result: $80 >> channel
sndFade                = $0797 ; 6 ; SC_FADE: high nibble = fade-in start volume, low nibble = timer reload (frames per step); cleared when the start volume is not below sndVolumeBase
sndTemp3               = $079A ; 4
sfxHeader              = $079F ; 4 ; header byte of the SFX being started
sndOctave              = $07A4 ; 2 ; SC_OCTAVE
sndTranspose           = $07A7 ; 3 ; SC_TRANSPOSE: bit 7 = down
sndNotePeriodLo        = $07AA ; 4 ; period of the current note (before vibrato / detune)
sndNotePeriodHi        = $07AD ; 4
sndEnvTimer            = $07B0 ; 11 ; frames left of the envelope step
sndRegOffset           = $07B2 ; 3 ; APU register offset of the channel (ChannelRegs)
sndVibDelay            = $07B3 ; 6 ; frames until the next vibrato / pitch-envelope step (UpdateChannel counts it down; VibratoNext reloads it from the table's high nibble)
sndEnvPos              = $07B6 ; 9 ; position in the volume envelope (vibrato: +3)
sndChannelsLeft        = $07B8 ; 4 ; SoundStart / StartMusic loop counter
sndVibIdx              = $07B9 ; 5 ; (size 6) per channel: index into the vibrato / pitch-envelope table (VibratoNext reads EnvelopePtrs table at this offset, then increments it)
sndEnvLoop             = $07BC ; 2 ; ENV_LOOP position
sndEnvRepeat           = $07C2 ; 3 ; ENV_REPEAT counter
sndPausedLast          = $07C4 ; 2 ; gamePaused as of the last frame
sndVibId               = $07C8 ; 2 ; SC_VIBRATO: envelope id of the pitch steps
sndVibDepth            = $07CB ; 4 ; second SC_VIBRATO byte: low nibble = depth multiplier (VibratoScaleDepth), high nibble = start delay in base lengths (StartVibrato)
sndVibOffsetLo         = $07CE ; 5 ; pitch offset of the vibrato
sndVibOffsetHi         = $07D1 ; 3
sndEnvId               = $07D4 ; 8 ; SC_ENV / third SC_LEN byte: bit 7 set = fade mode (volume decay by sndFade / sndRelease, no table; low nibble = sndFadeSteps), clear = EnvelopePtrs offset (EnvelopeNext)
fadeOutTimer           = $07D6 ; 4
sndRelease             = $07D7 ; 8 ; SC_RELEASE: the note is cut after n/16 of its length (0 = never)
sndReleaseAt           = $07DA ; 6 ; sndTimer value at which the note is cut
sndEchoLo              = $07DD ; 3 ; (size 8) recent note periods (SQ1: 0-3, SQ2: 4-7)
sndEchoHi              = $07E5 ; 3 ; (size 8) 
sndPacked              = $07ED ; 9 ; SC_PACKED state: bit 4 = packed mode, bit 0 = double length, bit 7 = SC_PACKED / SC_PACKED2 armed (SNDP_ARMED; the byte & $81 is stored, the same command again clears it)
musicSkipPeriod        = $07F1 ; 4 ; SC_DIVIDER: every n-th frame the music channels skip their update (slower tempo)
musicSkipCount         = $07F2 ; 5
musicSkipNow           = $07F3 ; 4 ; 1 in a skipped frame
sampleTimer            = $07F4 ; 10 ; frames left of the DPCM sample (PlaySample ignores new ones while it runs)
