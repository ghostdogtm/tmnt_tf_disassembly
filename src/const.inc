.enum                                   ; fighter phase (objPhase of slots 0/1), handled by FighterPhase
  PHASE_SPAWN                           ; 0: place at the start position, full health
  PHASE_READY                           ; 1: one frame: sets the intro timer
  PHASE_INTRO                           ; 2: waiting for the round to start
  PHASE_FIGHT                           ; 3: objState runs
  PHASE_KO                              ; 4: knocked out / round lost (objState = step)
.endenum
.enum                                   ; fighter action state (objState while PHASE_FIGHT), handled by FighterState
  FST_STAND                             ; 0: on the floor: walk, turn, read buttons
  FST_JUMP                              ; 1
  FST_SHOT                              ; 2: crouch pose, then throws the ball (object slot 6: ballOwner, fighterHasBall, SND_SHOT); Down held: FST_CROUCH, else stand
  FST_HURT                              ; 3: hit reaction, kind in objHitType
  FST_KNOCKDOWN                         ; 4: thrown up, falls, lies, gets up (buttons speed it up)
  FST_SPECIAL                           ; 5: animated special move (SpecialScriptStart / SpecialFxFrames); its effect object is slot $0C + fighter
  FST_TURN                              ; 6: turns round to face the opponent
  FST_CROUCH                            ; 7
  FST_CHAR_MOVE                         ; 8: per-character move (jump table on objSpriteSet)
  FST_HOLD                              ; 9: holds the opponent (throw / repeated hits)
  FST_HELD                              ; $0A: held by the opponent, loses health on each hit
  FST_0B                                ; $0B: caught in the opponent's character move (State0B: blinking frame, SND_STATE_0B, not pushed apart by SeparateFighters; ShredderBoltsWait waits for it); back to air hurt when the opponent's FST_CHAR_MOVE step ends; not seen in the Mesen runs
  FST_WIN                               ; $0C: victory pose and voice
.endenum
.enum                                   ; characters (fighterChar, objSpriteSet of the fighters)
  CHAR_LEO                              ; 0
  CHAR_RAPH                             ; 1
  CHAR_MIKE                             ; 2: order of FighterNames / FighterNamesHud (indexed by fighterChar in DrawFighterNames)
  CHAR_DON                              ; 3
  CHAR_CASEY                            ; 4
  CHAR_HOTHEAD                          ; 5
  CHAR_SHREDDER                         ; 6
.endenum
